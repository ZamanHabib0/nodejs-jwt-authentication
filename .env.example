# =============================================================================
#  Copy this file to .env and fill in real values:
#
#      cp .env.example .env
#
#  Generate ENCRYPTION_KEY with:
#      node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
#  Variable names match src/config/var.js exactly. Do not rename them — the
#  names in README.md are outdated and will leave values undefined.
#  Keep this file free of real secrets; it is committed to the repo.
# =============================================================================


# --- Server ------------------------------------------------------------------
# Keep 8080 locally — the Google OAuth callback is hardcoded to that port.
# Leave unset on Railway; the platform injects PORT.
PORT=8080

# "development" enables Mongoose query logging. Use "production" when deployed.
NODE_ENV=development


# --- MongoDB -----------------------------------------------------------------
# NOT MONGODB_URI. A bad value kills the process on boot with no error message.
MONGO_URI=


# --- JWT ---------------------------------------------------------------------
# The JWT signing secret, despite the name. NOT JWT_SECRET.
ENCRYPTION_KEY=

# Token lifetime in minutes. Plain number only. 1440 = 24 hours.
JWT_EXPIRATION_MINUTES=1440


# --- Cloudinary --------------------------------------------------------------
# Required for signUp — registration fails with a 500 without these.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# --- Email (Nodemailer / Gmail) ----------------------------------------------
# Lowercase on purpose — the code reads process.env.email / process.env.password.
# NOT EMAIL_USER / EMAIL_PASS. Requires a Gmail App Password, not the account
# password.
email=
password=


# --- Google OAuth 2.0 --------------------------------------------------------
# Register this redirect URI on the Google client:
#   http://localhost:8080/admin/auth/google/callback
# The callback URL itself is hardcoded in src/config/google.auth.js — there is
# no env var for it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
