  "item": [
    {
      "name": "Server Health Check (Base URL)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            ""
          ]
        },
        "description": "Hit the server Base URL or /health to check if the server is up and returns a 200 OK status."
      }
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Sign Up (Direct without OTP)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData && jsonData.data && jsonData.data.authToken) {",
                  "    pm.collectionVariables.set(\"authToken\", jsonData.data.authToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userName\": \"Zaman Habib\",\n  \"email\": \"zaman@example.com\",\n  \"password\": \"Password123!\",\n  \"role\": \"admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/auth/signUp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "auth",
                "signUp"
              ]
            },
            "description": "Register a new user directly without requiring OTP / email verification. Automatically captures the authToken into collection variables."
          }
        },
        {
          "name": "Sign In",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData && jsonData.data && jsonData.data.authToken) {",
                  "    pm.collectionVariables.set(\"authToken\", jsonData.data.authToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"zaman@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/auth/signIn",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "auth",
                "signIn"
              ]
            },
            "description": "Log in with email and password to receive a JWT authToken."
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"zaman@example.com\",\n  \"newPassword\": \"NewPassword123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/auth/resetPassword",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "auth",
                "resetPassword"
              ]
            },
            "description": "Directly resets the user password."
          }
        },
        {
          "name": "Google Auth Login (Browser)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/auth/google",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "auth",
                "google"
              ]
            },
            "description": "Initiate Google OAuth 2.0 flow."
          }
        }
      ]
    },
    {
      "name": "Blog CRUD",
      "item": [
        {
          "name": "Create Blog Post",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData && jsonData.data && jsonData.data._id) {",
                  "    pm.collectionVariables.set(\"blogId\", jsonData.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"How to Build Scalable APIs with Node.js and MongoDB\",\n  \"content\": \"In this comprehensive tutorial, we cover everything you need to know about building robust backend architectures using Express and Mongoose.\",\n  \"shortDescription\": \"A complete guide to scalable Node.js backend development.\",\n  \"category\": \"Technology\",\n  \"tags\": [\"Node.js\", \"Express\", \"MongoDB\", \"Backend\"],\n  \"author\": \"Zaman Habib\",\n  \"status\": \"published\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/blogs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "blogs"
              ]
            },
            "description": "Create a new blog post. Automatically stores the created blog's _id into collection variable `blogId`."
          }
        },
        {
          "name": "Get All Blogs (Search, Filter, Pagination)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/blogs?page=1&limit=10&search=&category=Technology&status=published",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "blogs"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "search",
                  "value": ""
                },
                {
                  "key": "category",
                  "value": "Technology"
                },
                {
                  "key": "status",
                  "value": "published"
                }
              ]
            },
            "description": "Retrieve paginated list of blog posts with optional search keywords and category/status filters."
          }
        },
        {
          "name": "Get Single Blog (by ID or Slug)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/blogs/{{blogId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "blogs",
                "{{blogId}}"
              ]
            },
            "description": "Fetch a single blog post using its Mongo `_id` or unique `slug`. Automatically increments the view counter."
          }
        },
        {
          "name": "Update Blog Post",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"How to Build Scalable APIs with Node.js and MongoDB (Updated Edition)\",\n  \"shortDescription\": \"An updated comprehensive guide to scalable Node.js architecture.\",\n  \"status\": \"published\",\n  \"category\": \"Backend Engineering\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/blogs/{{blogId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "blogs",
                "{{blogId}}"
              ]
            },
            "description": "Update an existing blog post by its `_id` or `slug`."
          }
        },
        {
          "name": "Delete Blog Post",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/blogs/{{blogId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "blogs",
                "{{blogId}}"
              ]
            },
            "description": "Delete a blog post by its `_id` or `slug`."
          }
        }
      ]
    },
    {
      "name": "Contact Us CRUD",
      "item": [
        {
          "name": "Submit Contact Inquiry",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData && jsonData.data && jsonData.data._id) {",
                  "    pm.collectionVariables.set(\"contactId\", jsonData.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ali Raza\",\n  \"email\": \"ali.raza@example.com\",\n  \"phone\": \"+923001234567\",\n  \"subject\": \"Custom Enterprise Integration Inquiry\",\n  \"message\": \"Hello, we are looking to integrate your AI CRM solution into our existing ERP system. Please contact us with a demo!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/contacts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "contacts"
              ]
            },
            "description": "Public endpoint to submit a contact inquiry form. Automatically stores the created contact inquiry `_id` into collection variable `contactId`."
          }
        },
        {
          "name": "Get All Contact Inquiries",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/contacts?page=1&limit=10&status=pending&search=",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "contacts"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "status",
                  "value": "pending"
                },
                {
                  "key": "search",
                  "value": ""
                }
              ]
            },
            "description": "List all contact submissions with status filtering (`pending`, `read`, `resolved`, `replied`), search keyword, and pagination."
          }
        },
        {
          "name": "Get Single Contact Inquiry",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/contacts/{{contactId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "contacts",
                "{{contactId}}"
              ]
            },
            "description": "Fetch single contact message by `_id`. Automatically transitions status from `pending` to `read`."
          }
        },
        {
          "name": "Update Contact Status & Admin Notes",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"resolved\",\n  \"adminNotes\": \"Called client on WhatsApp and scheduled demo for Monday 10:00 AM.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/contacts/{{contactId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "contacts",
                "{{contactId}}"
              ]
            },
            "description": "Update the status of a contact inquiry (e.g. `resolved`, `replied`, `read`) along with internal admin notes."
          }
        },
        {
          "name": "Delete Contact Inquiry",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/contacts/{{contactId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "contacts",
                "{{contactId}}"
              ]
            },
            "description": "Delete a contact submission by its `_id`."
          }
        }
      ]
    }
  ]
